diff --git a/src/core/SkBitmapDevice.cpp b/src/core/SkBitmapDevice.cpp
index bf96c90..c444799 100644
--- a/src/core/SkBitmapDevice.cpp
+++ b/src/core/SkBitmapDevice.cpp
@@ -218,7 +218,12 @@ public:
 
 static bool valid_for_bitmap_device(const SkImageInfo& info,
                                     SkAlphaType* newAlphaType) {
-    if (info.width() < 0 || info.height() < 0 || kUnknown_SkColorType == info.colorType()) {
+    // An empty (zero-sized) bitmap legitimately has an unknown color type: it
+    // has no pixels to describe.  Android's Canvas() default constructor uses
+    // exactly this shape (nInitRaster(0)), and release builds accept it.  Only
+    // reject an unknown color type when the bitmap actually has pixels.
+    if (info.width() < 0 || info.height() < 0 ||
+        (kUnknown_SkColorType == info.colorType() && !info.isEmpty())) {
         return false;
     }
 
