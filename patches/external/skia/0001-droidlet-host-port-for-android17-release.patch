 namespace GrAHardwareBufferUtils {
 
+namespace {
+
+PFNEGLCREATEIMAGEKHRPROC getCreateImageProc() {
+    static PFNEGLCREATEIMAGEKHRPROC proc =
+            reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    return proc;
+}
+
+PFNEGLDESTROYIMAGEKHRPROC getDestroyImageProc() {
+    static PFNEGLDESTROYIMAGEKHRPROC proc =
+            reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    return proc;
+}
+
+// libglvnd has no Android native-client-buffer provider.  Import the host
+// gralloc dma-buf directly with EGL_EXT_image_dma_buf_import instead.
+EGLImageKHR createDroidletDmaBufImage(EGLDisplay display, AHardwareBuffer* buffer) {
+    AHardwareBuffer_Desc desc{};
+    AHardwareBuffer_describe(buffer, &desc);
+    const native_handle_t* handle = AHardwareBuffer_getNativeHandle(buffer);
+    if (handle == nullptr || handle->numFds < 1) {
+        return EGL_NO_IMAGE_KHR;
+    }
+    int fourcc = 0;
+    int bytesPerPixel = 4;
+    switch (desc.format) {
+        case AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM:
+            fourcc = DRM_FORMAT_ABGR8888;
+            break;
+        case AHARDWAREBUFFER_FORMAT_B8G8R8A8_UNORM:
+            fourcc = DRM_FORMAT_ARGB8888;
+            break;
+        case AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT:
+            fourcc = DRM_FORMAT_ABGR16161616F;
+            bytesPerPixel = 8;
+            break;
+        case AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM:
+            fourcc = DRM_FORMAT_ABGR2101010;
+            break;
+        case AHARDWAREBUFFER_FORMAT_R8_UNORM:
+            fourcc = DRM_FORMAT_R8;
+            bytesPerPixel = 1;
+            break;
+        default:
+            return EGL_NO_IMAGE_KHR;
+    }
+    PFNEGLCREATEIMAGEKHRPROC create = getCreateImageProc();
+    if (create == nullptr) {
+        return EGL_NO_IMAGE_KHR;
+    }
+    const EGLint attrs[] = {
+            EGL_WIDTH, static_cast<EGLint>(desc.width),
+            EGL_HEIGHT, static_cast<EGLint>(desc.height),
+            EGL_LINUX_DRM_FOURCC_EXT, fourcc,
+            EGL_DMA_BUF_PLANE0_FD_EXT, handle->data[0],
+            EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+            EGL_DMA_BUF_PLANE0_PITCH_EXT,
+            static_cast<EGLint>(desc.stride * bytesPerPixel),
+            EGL_NONE,
+    };
+    return create(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+}
+
+}  // namespace
+
 GrBackendFormat GetGLBackendFormat(GrDirectContext* dContext,
                                    uint32_t bufferFormat, bool requireKnownFormat) {
     GrBackendApi backend = dContext->backend();
@@ -84,7 +151,10 @@ public:
     ~GLTextureHelper() {
         glDeleteTextures(1, &fTexID);
         // eglDestroyImageKHR will remove a ref from the AHardwareBuffer
-        eglDestroyImageKHR(fDisplay, fImage);
+        PFNEGLDESTROYIMAGEKHRPROC destroy = getDestroyImageProc();
+        if (destroy != nullptr && fImage != EGL_NO_IMAGE_KHR) {
+            destroy(fDisplay, fImage);
+        }
     }
     void rebind(GrDirectContext*);
 
@@ -138,15 +208,26 @@ static GrBackendTexture make_gl_backend_texture(
         return GrBackendTexture();
     }
 
-    EGLClientBuffer clientBuffer = eglGetNativeClientBufferANDROID(hardwareBuffer);
+    EGLDisplay display = eglGetCurrentDisplay();
+    const char* extensions = eglQueryString(display, EGL_EXTENSIONS);
     EGLint attribs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
                          isProtectedContent ? EGL_PROTECTED_CONTENT_EXT : EGL_NONE,
                          isProtectedContent ? EGL_TRUE : EGL_NONE,
                          EGL_NONE };
-    EGLDisplay display = eglGetCurrentDisplay();
-    // eglCreateImageKHR will add a ref to the AHardwareBuffer
-    EGLImageKHR image = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
-                                          clientBuffer, attribs);
+    EGLImageKHR image = EGL_NO_IMAGE_KHR;
+    if (extensions != nullptr &&
+        strstr(extensions, "EGL_ANDROID_get_native_client_buffer") != nullptr) {
+        EGLClientBuffer clientBuffer = eglGetNativeClientBufferANDROID(hardwareBuffer);
+        PFNEGLCREATEIMAGEKHRPROC create = getCreateImageProc();
+        if (create != nullptr) {
+            // eglCreateImageKHR will add a ref to the AHardwareBuffer
+            image = create(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, clientBuffer,
+                           attribs);
+        }
+    } else if (extensions != nullptr &&
+               strstr(extensions, "EGL_EXT_image_dma_buf_import") != nullptr) {
+        image = createDroidletDmaBufImage(display, hardwareBuffer);
+    }
     if (EGL_NO_IMAGE_KHR == image) {
         SKIA_LOG_E("Could not create EGL image, err = (%#x)", (int) eglGetError() );
         return GrBackendTexture();
@@ -178,14 +259,16 @@ static GrBackendTexture make_gl_backend_texture(
     if ((status = glGetError()) != GL_NO_ERROR) {
         SKIA_LOG_E("glBindTexture failed (%#x)", (int) status);
         glDeleteTextures(1, &texID);
-        eglDestroyImageKHR(display, image);
+        PFNEGLDESTROYIMAGEKHRPROC destroy = getDestroyImageProc();
+        if (destroy != nullptr) destroy(display, image);
         return GrBackendTexture();
     }
     glEGLImageTargetTexture2DOES(target, image);
     if ((status = glGetError()) != GL_NO_ERROR) {
         SKIA_LOG_E("glEGLImageTargetTexture2DOES failed (%#x)", (int) status);
         glDeleteTextures(1, &texID);
-        eglDestroyImageKHR(display, image);
+        PFNEGLDESTROYIMAGEKHRPROC destroy = getDestroyImageProc();
+        if (destroy != nullptr) destroy(display, image);
         return GrBackendTexture();
     }
     dContext->resetContext(kTextureBinding_GrGLBackendState);
