+/** Output rate of the desktop mixer, in milliHz. */
+
+#define OUTPUT_SAMPLE_RATE_MILLIHZ 44100000
+
+/** Reset the host format conversion state for a track. */
+
+static void track_reset_converter(Track *track)
+{
+    track->mResamplePos = 0.0;
+    track->mHavePrev = SL_BOOLEAN_FALSE;
+    track->mHaveNext = SL_BOOLEAN_FALSE;
+    track->mPrevFrame[0] = 0;
+    track->mPrevFrame[1] = 0;
+    track->mNextFrame[0] = 0;
+    track->mNextFrame[1] = 0;
+}
+
+/** Convert one sample in the track's source format to signed 16-bit PCM. */
+
+static short track_convert_sample(const SLuint8 *src, SLuint32 containerSize,
+        SLuint32 representation)
+{
+    switch (containerSize) {
+    case 8: {
+        // 8-bit PCM is unsigned, with 128 as the midpoint
+        return (short) (((int) src[0] - 128) << 8);
+    }
+    case 16: {
+        SLint16 value;
+        memcpy(&value, src, sizeof(value));
+        return value;
+    }
+    case 24: {
+        // sign-extend a little-endian 24-bit sample, then keep the top 16 bits
+        SLint32 value = (SLint32) (((SLuint32) src[0] << 8) | ((SLuint32) src[1] << 16) |
+                ((SLuint32) src[2] << 24));
+        return (short) (value >> 16);
+    }
+    case 32: {
+        if (SL_ANDROID_PCM_REPRESENTATION_FLOAT == representation) {
+            float value;
+            memcpy(&value, src, sizeof(value));
+            if (value > 1.0f) {
+                value = 1.0f;
+            } else if (value < -1.0f) {
+                value = -1.0f;
+            }
+            return (short) lrintf(value * 32767.0f);
+        } else {
+            SLint32 value;
+            memcpy(&value, src, sizeof(value));
+            return (short) (value >> 16);
+        }
+    }
+    default:
+        return 0;
+    }
+}
+
+/** Advance to the next source buffer, invoking the application callback.
+ *  Returns true if more data is available. */
+
+static SLboolean track_advance_buffer(Track *track)
+{
+    CAudioPlayer *audioPlayer = track->mAudioPlayer;
+    IBufferQueue *bufferQueue = &audioPlayer->mBufferQueue;
+    interface_lock_exclusive(bufferQueue);
+    const BufferHeader *oldFront = bufferQueue->mFront;
+    const BufferHeader *rear = bufferQueue->mRear;
+    // a buffer stays on queue while playing, so it better still be there
+    assert(oldFront != rear);
+    const BufferHeader *newFront = oldFront;
+    if (++newFront == &bufferQueue->mArray[bufferQueue->mNumBuffers + 1]) {
+        newFront = bufferQueue->mArray;
+    }
+    bufferQueue->mFront = (BufferHeader *) newFront;
+    assert(0 < bufferQueue->mState.count);
+    --bufferQueue->mState.count;
+    SLboolean more = SL_BOOLEAN_FALSE;
+    if (newFront != rear) {
+        assert(0 < bufferQueue->mState.count);
+        track->mReader = newFront->mBuffer;
+        track->mAvail = newFront->mSize;
+        more = SL_BOOLEAN_TRUE;
+    } else {
+        track->mReader = NULL;
+        track->mAvail = 0;
+    }
+    ++bufferQueue->mState.playIndex;
+    slBufferQueueCallback callback = bufferQueue->mCallback;
+    void *context = bufferQueue->mContext;
+    interface_unlock_exclusive(bufferQueue);
+    if (NULL != callback) {
+        (*callback)((SLBufferQueueItf) bufferQueue, context);
+        if (!more) {
+            // the callback may have enqueued more data
+            interface_lock_shared(bufferQueue);
+            if (bufferQueue->mFront != bufferQueue->mRear) {
+                track->mReader = bufferQueue->mFront->mBuffer;
+                track->mAvail = bufferQueue->mFront->mSize;
+                more = SL_BOOLEAN_TRUE;
+            }
+            interface_unlock_shared(bufferQueue);
+        }
+    }
+    return more;
+}
+
+/** Read one source frame from the track, converting it to stereo 16-bit. */
+
+static SLboolean track_read_frame(Track *track)
+{
+    while (track->mAvail < track->mFrameBytes) {
+        if (0 != track->mAvail) {
+            // discard a partial frame at the end of a malformed buffer
+            track->mAvail = 0;
+        }
+        if (NULL == track->mReader) {
+            return SL_BOOLEAN_FALSE;
+        }
+        if (!track_advance_buffer(track)) {
+            return SL_BOOLEAN_FALSE;
+        }
+    }
+    const SLuint8 *src = (const SLuint8 *) track->mReader;
+    short left = track_convert_sample(src, track->mContainerSize, track->mRepresentation);
+    short right = left;
+    if (track->mNumChannels >= 2) {
+        right = track_convert_sample(src + track->mContainerSize / 8, track->mContainerSize,
+                track->mRepresentation);
+    }
+    track->mNextFrame[0] = left;
+    track->mNextFrame[1] = right;
+    track->mReader = src + track->mFrameBytes;
+    track->mAvail -= track->mFrameBytes;
+    ++track->mFramesMixed;
+    return SL_BOOLEAN_TRUE;
+}
+
+/** Produce one 44.1 kHz stereo 16-bit frame from the track source. */
+
+static SLboolean track_resample_frame(Track *track, short out[STEREO_CHANNELS])
+{
+    if (!track->mHaveNext) {
+        if (!track_read_frame(track)) {
+            return SL_BOOLEAN_FALSE;
+        }
+        if (!track->mHavePrev) {
+            track->mPrevFrame[0] = track->mNextFrame[0];
+            track->mPrevFrame[1] = track->mNextFrame[1];
+            track->mHavePrev = SL_BOOLEAN_TRUE;
+        }
+        track->mHaveNext = SL_BOOLEAN_TRUE;
+    }
+
+    double phase = track->mResamplePos;
+    out[0] = (short) (track->mPrevFrame[0] +
+            (track->mNextFrame[0] - track->mPrevFrame[0]) * phase);
+    out[1] = (short) (track->mPrevFrame[1] +
+            (track->mNextFrame[1] - track->mPrevFrame[1]) * phase);
+
+    track->mResamplePos += (double) track->mSampleRateMilliHz / OUTPUT_SAMPLE_RATE_MILLIHZ;
+    while (track->mResamplePos >= 1.0) {
+        track->mResamplePos -= 1.0;
+        track->mPrevFrame[0] = track->mNextFrame[0];
+        track->mPrevFrame[1] = track->mNextFrame[1];
+        track->mHaveNext = track_read_frame(track);
+        if (!track->mHaveNext) {
+            break;
+        }
+    }
+    return SL_BOOLEAN_TRUE;
+}
