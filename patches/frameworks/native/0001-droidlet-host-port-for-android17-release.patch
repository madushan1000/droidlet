+    size_t cursor = dataStart;
+
+    for (size_t offset : offsets) {
+        if (offset < cursor) {
+            ALOGE("Legacy Parcel object offsets overlap at %zu", offset);
+            return BAD_VALUE;
+        }
+        converted.insert(converted.end(), mData + cursor, mData + offset);
+        const auto* obj = reinterpret_cast<const flat_binder_object*>(mData + offset);
+        const uint32_t objectPosition = static_cast<uint32_t>(converted.size());
+        if (obj->hdr.type == BINDER_TYPE_FD) {
+            const int32_t fdIndex = static_cast<int32_t>(fds.size());
+            if (obj->cookie != 0) {
+                int dupFd = fcntl(static_cast<int>(obj->handle), F_DUPFD_CLOEXEC, 0);
+                if (dupFd < 0) {
