@@ -367,21 +399,50 @@ Status BackendUnifiedServiceManager::registerForNotifications(
     if (mTheRealServiceManager) {
         return mTheRealServiceManager->registerForNotifications(name, callback);
     }
-    return Status::fromExceptionCode(Status::EX_UNSUPPORTED_OPERATION,
-                                     kUnsupportedOpNoServiceManager);
+    if (callback == nullptr) {
+        return Status::fromExceptionCode(Status::EX_NULL_POINTER);
+    }
+
+    sp<IBinder> existing;
+    {
+        std::lock_guard<std::mutex> lock(mLocalMutex);
+        auto it = mLocalServices.find(name);
+        if (it != mLocalServices.end()) {
+            existing = it->second.binder;
+        } else {
+            mLocalCallbacks[name].push_back(callback);
+            return Status::ok();
+        }
+    }
+
+    // Already registered: notify immediately, outside the lock.
+    return callback->onRegistration(name, existing);
 }
 Status BackendUnifiedServiceManager::unregisterForNotifications(
         const ::std::string& name, const sp<os::IServiceCallback>& callback) {
     if (mTheRealServiceManager) {
         return mTheRealServiceManager->unregisterForNotifications(name, callback);
     }
-    return Status::fromExceptionCode(Status::EX_UNSUPPORTED_OPERATION,
-                                     kUnsupportedOpNoServiceManager);
+
+    std::lock_guard<std::mutex> lock(mLocalMutex);
+    auto it = mLocalCallbacks.find(name);
+    if (it != mLocalCallbacks.end()) {
+        auto& callbacks = it->second;
+        callbacks.erase(std::remove(callbacks.begin(), callbacks.end(), callback),
+                        callbacks.end());
+        if (callbacks.empty()) {
+            mLocalCallbacks.erase(it);
+        }
+    }
+    return Status::ok();
 }
