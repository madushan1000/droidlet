+            // while we hand the binder to the RPC state; releaseObjects()
+            // below drops the kernel reference.
+            binder->incStrong(this);
+            uint64_t address = 0;
+            status_t status =
+                    session->state()->onBinderLeaving(*session, binder, &address);
+            if (status != NO_ERROR) {
+                binder->decStrong(this);
+                return status;
+            }
+            appendInt32(&converted, RpcFields::TYPE_BINDER);
+            appendUint64(&converted, address);
+            if (includeBinderPositions) {
+                objectPositions.push_back(objectPosition);
+            }
+        } else if (obj->hdr.type == BINDER_TYPE_HANDLE) {
+            sp<IBinder> binder =
+                    ProcessState::self()->getStrongProxyForHandle(obj->handle);
+            if (binder == nullptr) {
+                return BAD_VALUE;
+            }
+            binder->incStrong(this);
+            uint64_t address = 0;
+            status_t status =
+                    session->state()->onBinderLeaving(*session, binder, &address);
+            if (status != NO_ERROR) {
+                binder->decStrong(this);
+                return status;
+            }
+            appendInt32(&converted, RpcFields::TYPE_BINDER);
+            appendUint64(&converted, address);
+            if (includeBinderPositions) {
+                objectPositions.push_back(objectPosition);
+            }
+        }
+        cursor = offset + sizeof(flat_binder_object);
+    }
+    converted.insert(converted.end(), mData + cursor, mData + mDataSize);
+
+    uint8_t* newData = static_cast<uint8_t*>(malloc(converted.size()));
+    if (newData == nullptr) {
+        return NO_MEMORY;
+    }
+    memcpy(newData, converted.data(), converted.size());
+
+    // Drop the original kernel object references and owned fds now that the
+    // converted data owns (duplicates of) everything it needs.
+    releaseObjects();
+    free(kernelFields->mObjects);
+    kernelFields->mObjects = nullptr;
+    kernelFields->mObjectsSize = 0;
+
+    gParcelGlobalAllocSize += converted.size();
+    gParcelGlobalAllocSize -= mDataCapacity;
+    free(mData);
+    mData = newData;
+    mDataSize = converted.size();
+    mDataCapacity = converted.size();
+    mDataPos = mDataSize;
+
+    sp<RpcSession> rpcSession = session;
+    mVariantFields.emplace<RpcFields>(std::move(rpcSession));
+    auto* rpcFields = maybeRpcFields();
+    rpcFields->mObjectPositions = std::move(objectPositions);
+    (void)rpcFields->maybeMakeImpl();
+    rpcFields->mImpl->mFds = std::move(fds);
+    return NO_ERROR;
+#else
+    (void)session;
+    return INVALID_OPERATION;
+#endif
+}
