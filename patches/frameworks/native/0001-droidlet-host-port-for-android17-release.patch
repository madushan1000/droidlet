+            } else {
+                fds.emplace_back(binder::borrowed_fd(static_cast<int>(obj->handle)));
+            }
+            appendInt32(&converted, RpcFields::TYPE_NATIVE_FILE_DESCRIPTOR);
+            appendInt32(&converted, fdIndex);
+            objectPositions.push_back(objectPosition);
+        } else if (obj->hdr.type == BINDER_TYPE_BINDER) {
+            if (obj->binder == 0 || obj->cookie == 0) {
+                appendInt32(&converted, RpcFields::TYPE_BINDER_NULL);
+                cursor = offset + sizeof(flat_binder_object);
+                continue;
+            }
+            auto* raw = reinterpret_cast<IBinder*>(obj->cookie);
+            sp<IBinder> binder = sp<IBinder>::fromExisting(raw);
