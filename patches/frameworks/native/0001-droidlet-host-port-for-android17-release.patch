+status_t Parcel::convertToRpc(const sp<RpcSession>& session) {
+#ifdef BINDER_WITH_KERNEL_IPC
+    if (session == nullptr) {
+        return BAD_VALUE;
+    }
+    if (auto* rpcFields = maybeRpcFields()) {
+        return rpcFields->mSession == session ? NO_ERROR : BAD_VALUE;
+    }
+    if (mOwner != nullptr) {
+        ALOGE("Cannot convert an IPC-owned Parcel to RPC");
+        return INVALID_OPERATION;
+    }
+
+    auto* kernelFields = maybeKernelFields();
+
+    // Legacy AIDL writes a three-int Binder header before the interface
+    // string.  RPC parcels carry only the string, so strip the header when it
+    // is present.  AIDL proxies write it at the start, before any arguments.
+    size_t dataStart = 0;
+    if (mData != nullptr && mDataSize >= 16) {
+        int32_t header = 0;
+        memcpy(&header, mData + 8, sizeof(header));
+        int32_t interfaceLength = 0;
+        memcpy(&interfaceLength, mData + 12, sizeof(interfaceLength));
+        if (header == kHeader && interfaceLength >= 0 &&
+            static_cast<size_t>(interfaceLength) <= (mDataSize - 16) / sizeof(char16_t)) {
+            dataStart = 12;
+        }
+    }
+
+    auto switchToRpc = [&](size_t start) -> status_t {
+        if (start > 0 && mData != nullptr) {
+            const size_t newSize = mDataSize - start;
+            uint8_t* newData = static_cast<uint8_t*>(malloc(newSize));
+            if (newData == nullptr) {
+                return NO_MEMORY;
+            }
+            memcpy(newData, mData + start, newSize);
+            gParcelGlobalAllocSize += newSize;
+            gParcelGlobalAllocSize -= mDataCapacity;
+            free(mData);
+            mData = newData;
+            mDataSize = newSize;
+            mDataCapacity = newSize;
+            mDataPos = newSize;
+        }
+        if (kernelFields != nullptr) {
+            free(kernelFields->mObjects);
+            kernelFields->mObjects = nullptr;
+            kernelFields->mObjectsSize = 0;
+        }
+        sp<RpcSession> rpcSession = session;
+        mVariantFields.emplace<RpcFields>(std::move(rpcSession));
+        return NO_ERROR;
+    };
+
+    if (kernelFields == nullptr || mData == nullptr || kernelFields->mObjectsSize == 0) {
+        // No kernel-wire objects: only the parcel's bookkeeping (and possibly
+        // the legacy interface header) needs to change.
+        return switchToRpc(dataStart);
+    }
+
+    std::vector<binder_size_t> nullBinderPositions;
+    {
+        std::lock_guard<std::mutex> lock(gLegacyNullBinderLock);
+        auto it = gLegacyNullBinders.find(this);
+        if (it != gLegacyNullBinders.end()) {
+            nullBinderPositions = std::move(it->second);
+            gLegacyNullBinders.erase(it);
+        }
+    }
+    std::vector<size_t> offsets(kernelFields->mObjects,
+                                kernelFields->mObjects + kernelFields->mObjectsSize);
+    offsets.insert(offsets.end(), nullBinderPositions.begin(), nullBinderPositions.end());
+    std::sort(offsets.begin(), offsets.end());
+    offsets.erase(std::unique(offsets.begin(), offsets.end()), offsets.end());
