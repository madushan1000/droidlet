+// The host EGL has EGL_EXT_image_dma_buf_import but no Android native-buffer
+// extension.  Import the host gralloc dma-buf directly so hardware bitmaps
+// can still use a GPU texture instead of falling back to CPU bitmaps.
+static EGLImageKHR createDmaBufImage(EGLDisplay display, AHardwareBuffer* ahb) {
+    const GraphicBuffer* graphicBuffer = AHardwareBuffer_to_GraphicBuffer(ahb);
+    if (graphicBuffer == nullptr || graphicBuffer->handle == nullptr ||
+        graphicBuffer->handle->numFds < 1) {
+        return EGL_NO_IMAGE_KHR;
+    }
+    HostBufferInfo info;
+    if (!hostBufferIsHostHandle(graphicBuffer->handle) ||
+        hostBufferReadHandle(graphicBuffer->handle, &info) != OK ||
+        info.backend != HostBufferBackend::DmaHeap) {
+        return EGL_NO_IMAGE_KHR;
+    }
+    int fourcc = 0;
+    int bytesPerPixel = 4;
+    switch (info.format) {
+        case PIXEL_FORMAT_RGBA_8888:
+            fourcc = DRM_FORMAT_ABGR8888;
+            break;
+        case PIXEL_FORMAT_BGRA_8888:
+            fourcc = DRM_FORMAT_ARGB8888;
+            break;
+        case PIXEL_FORMAT_RGBX_8888:
+            fourcc = DRM_FORMAT_XBGR8888;
+            break;
+        case PIXEL_FORMAT_RGBA_FP16:
+            fourcc = DRM_FORMAT_ABGR16161616F;
+            bytesPerPixel = 8;
+            break;
+        case PIXEL_FORMAT_RGBA_1010102:
+            fourcc = DRM_FORMAT_ABGR2101010;
+            break;
+        default:
+            return EGL_NO_IMAGE_KHR;
+    }
+    const EGLint attrs[] = {
+            EGL_WIDTH, static_cast<EGLint>(info.width),
+            EGL_HEIGHT, static_cast<EGLint>(info.height),
+            EGL_LINUX_DRM_FOURCC_EXT, fourcc,
+            EGL_DMA_BUF_PLANE0_FD_EXT, graphicBuffer->handle->data[0],
+            EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+            EGL_DMA_BUF_PLANE0_PITCH_EXT,
+            static_cast<EGLint>(info.stride * bytesPerPixel),
+            EGL_NONE,
+    };
+    return createEglImage(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+}
