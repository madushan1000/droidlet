 libcutils/include/cutils/trace.h           |  4 +-
 libcutils/trace-host.cpp                   |  2 +-
 libprocessgroup/setup/cgroup_map_write.cpp |  1 +
 libutils/Threads.cpp                       | 36 ++++++-------
