diff --git a/runtime/thread.cc b/runtime/thread.cc
index c3a28d5..842974b 100644
--- a/runtime/thread.cc
+++ b/runtime/thread.cc
@@ -791,7 +791,7 @@ static size_t FixStackSize(size_t stack_size) {
 
   // It's not possible to request a stack smaller than the system-defined PTHREAD_STACK_MIN.
   if (stack_size < PTHREAD_STACK_MIN) {
-    stack_size = PTHREAD_STACK_MIN;
+    stack_size = (size_t)PTHREAD_STACK_MIN;
   }
 
   if (Runtime::Current()->GetImplicitStackOverflowChecks()) {
@@ -5106,6 +5106,16 @@ int Thread::SetNativeNiceness(int niceness) {
   if (ret == 0) {
     return 0;
   }
+  // The host process normally lacks CAP_SYS_NICE, so Android's negative
+  // audio/display priorities cannot be applied.  Treat a denied negative
+  // niceness as best-effort success so framework threads (HandlerThread,
+  // ExoPlayer, media codecs) still start at the default niceness instead of
+  // aborting with a SecurityException.
+  if (niceness < 0 && (errno == EPERM || errno == EACCES)) {
+    LOG(INFO) << "Cannot raise thread niceness to " << niceness
+              << "; continuing at default priority";
+    return 0;
+  }
   LOG(WARNING) << "Cannot set niceness to " << niceness;
   // TODO: With PaletteMapPriority we may want to do more here.
   return errno;
