+#if !defined(ART_TARGET_ANDROID)
+// Host replacement loader for bionic-linked app JNI libraries.
+extern "C" {
+void* bionic_dlopen(const char* filename, int flags);
+void* bionic_dlsym(void* handle, const char* symbol);
+int bionic_dlclose(void* handle);
+const char* bionic_dlerror(void);
+void dl_parse_library_path(const char* path, char* delim);
+}
+
+static bool IsAppNativeLibraryPath(const char* path, const std::string& library_path) {
+  if (std::getenv("DROIDLET_NO_BIONIC_JNI") != nullptr) {
+    return false;
+  }
+  const char* android_data = std::getenv("ANDROID_DATA");
+  if (android_data == nullptr || android_data[0] == '\0') {
+    return false;
+  }
+  std::string app_root(android_data);
+  app_root += "/app/";
+  auto under_app_root = [&app_root](const char* candidate) {
+    return candidate != nullptr && candidate[0] == '/' &&
+           std::strncmp(candidate, app_root.c_str(), app_root.size()) == 0;
+  };
+  return under_app_root(path) || under_app_root(library_path.c_str());
+}
+#endif
+
 namespace android {
 
 namespace {
@@ -470,17 +501,28 @@ void* OpenNativeLibrary(JNIEnv* env,
 #else   // !ART_TARGET_ANDROID
   UNUSED(env, target_sdk_version, class_loader, caller_location);
 
-  // Do some best effort to emulate library-path support. It will not
-  // work for dependencies.
-  //
-  // Note: null has a special meaning and must be preserved.
-  std::string library_path;  // Empty string by default.
-  if (library_path_j != nullptr && path != nullptr && path[0] != '/') {
+  // Best-effort host library path support.  bionic_translation needs the
+  // directory in its own search path even when ART passes an absolute path.
+  std::string library_path;
+  if (library_path_j != nullptr) {
     ScopedUtfChars library_path_utf_chars(env, library_path_j);
     library_path = library_path_utf_chars.c_str();
   }
 
+  if (library_path.empty() && path != nullptr && path[0] == '/') {
+    std::string dir(path);
+    size_t slash = dir.find_last_of('/');
+    if (slash != std::string::npos) {
+      library_path = dir.substr(0, slash);
+    }
+  }
+
   std::vector<std::string> library_paths = base::Split(library_path, ":");
+  const bool use_bionic = IsAppNativeLibraryPath(path, library_path);
+
+  if (use_bionic && !library_path.empty()) {
+    dl_parse_library_path(library_path.c_str(), const_cast<char*>(":"));
+  }
 
   for (const std::string& lib_path : library_paths) {
     *needs_native_bridge = false;
@@ -489,6 +531,8 @@ void* OpenNativeLibrary(JNIEnv* env,
     if (path == nullptr) {
       // Preserve null.
       path_arg = nullptr;
+    } else if (path[0] == '/') {
+      path_arg = path;
     } else {
       complete_path = lib_path;
       if (!complete_path.empty()) {
@@ -497,7 +541,7 @@ void* OpenNativeLibrary(JNIEnv* env,
       complete_path.append(path);
       path_arg = complete_path.c_str();
     }
-    void* handle = dlopen(path_arg, RTLD_NOW);
+    void* handle = use_bionic ? bionic_dlopen(path_arg, RTLD_NOW) : dlopen(path_arg, RTLD_NOW);
     if (handle != nullptr) {
       return handle;
     }
@@ -509,7 +553,15 @@ void* OpenNativeLibrary(JNIEnv* env,
       }
       *error_msg = strdup(NativeBridgeGetError());
     } else {
-      *error_msg = strdup(dlerror());
+      const char* error = use_bionic ? bionic_dlerror() : dlerror();
+      if (error == nullptr) {
+        error = "unknown native library load failure";
+      }
+      if (use_bionic) {
+        fprintf(stderr, "bionic JNI load failed for %s: %s\n",
+                path_arg != nullptr ? path_arg : "(null)", error);
+      }
+      *error_msg = strdup(error);
     }
   }
   return nullptr;
@@ -524,10 +576,17 @@ bool CloseNativeLibrary(void* handle, const bool needs_native_bridge, char** err
       *error_msg = strdup(NativeBridgeGetError());
     }
   } else {
+#if defined(ART_TARGET_ANDROID)
     success = (dlclose(handle) == 0);
     if (!success) {
       *error_msg = strdup(dlerror());
     }
+#else
+    success = (bionic_dlclose(handle) == 0);
+    if (!success) {
+      *error_msg = strdup(bionic_dlerror());
+    }
+#endif
   }
 
   return success;
