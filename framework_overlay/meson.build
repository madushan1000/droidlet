framework_overlay_classes = jar(
  'framework-overlay-classes',
  files(
    'android/database/sqlite/SQLiteGlobal.java',
    'android/net/TrafficStats.java',
    'android/os/Trace.java',
    'android/os/DroidletEnvironment.java',
    'android/content/pm/PackagePartitions.java',
    'android/content/pm/SystemFeaturesCache.java',
    'android/provider/DroidletSettingsProvider.java',
    'android/graphics/fonts/SystemFonts.java',
    'com/android/internal/os/DebugStore.java',
    'android/app/DroidletLauncher.java',
    'android/app/DroidletLauncherActivities.java',
    'android/app/DroidletLauncherActivityServices.java',
    'android/app/DroidletLauncherBroadcasts.java',
    'android/app/DroidletLauncherInspection.java',
    'android/app/DroidletLauncherInstall.java',
    'android/app/DroidletLauncherJobs.java',
    'android/app/DroidletLauncherServices.java',
    'android/app/DroidletLauncherStartup.java',
    'android/app/DroidletLauncherSystemServices.java',
    'android/app/DroidletLauncherWindows.java',
    'android/hardware/DroidletSensorTicker.java',
    'android/security/DroidletKeyStoreBCWorkaroundProvider.java',
    'android/security/DroidletKeyStoreProvider.java',
    'android/window/WindowExtensionsHelper.java',
  ),
  java_args: [
    '-source', '21',
    '-target', '21',
    '-encoding', 'UTF-8',
    '-proc:none',
    '-nowarn',
    '-Xlint:-options',
    '-cp', prebuilt_android_all_jar,
  ],
)

framework_overlay_hostdex = custom_target(
  'framework-overlay-hostdex.jar',
  build_by_default: true,
  input: [framework_overlay_classes],
  output: 'framework-overlay-hostdex.jar',
  command: [
    d8,
    '--min-api', '35',
    '--output', '@OUTPUT@',
    '@INPUT@',
  ],
  install: true,
  install_dir: 'framework',
)
