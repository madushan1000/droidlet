<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.droidlet.serviceprocessapp">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <application
        android:label="@string/app_name"
        android:hasCode="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Same app, but a separate Android process. droidlet starts a child
             droidlet process and exposes RemoteService's binder over binder
             RPC on a nameless Unix socket pair. -->
        <service
            android:name=".RemoteService"
            android:process=":svc"
            android:exported="false" />
    </application>
</manifest>
