com_android_graphics_hwui_flags_cpp = custom_target(
  input: 'aconfig/hwui_flags.aconfig',
  command: [
    gen_aconfig_cpp_stubs,
    '@INPUT@',
    'com.android.graphics.hwui.flags',
  ],
  capture: true,
  output: 'com_android_graphics_hwui_flags.h',
)

