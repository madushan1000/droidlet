libhwui_includes = include_directories('.')

libhwui = shared_library(
  'hwui',
  [
    com_android_graphics_hwui_flags_cpp,
    com_android_graphics_surfaceflinger_flags_cpp,
    android_text_flags_cpp,
    libhwui_srcs,
  ],
  include_directories: [
    libhwui_includes,
    system_core_includes,
    frameworks_native_includes,
    frameworks_native_private_includes,
    frameworks_native_libs_math_includes,
    bionic_kernel_includes,
    'platform/android',
    'apex/include',
    'jni',
    '../../../av/media/ndk/include',
    '../../../native/opengl/libs/EGL/include',
  ],
  cpp_args: [
    '-std=c++20',
    '-D__ANDROID__',
    '-D__RENAME_IF_FILE_OFFSET64(func)=',
    '--include/usr/include/epoxy/egl.h',
    '-DLOG_TAG="HWUI"',
    '-D__INTRODUCED_IN(x)=',
    '-D__ANDROID_API__=26',
    '-DDROIDLET_HOST=1',
    #'-D__ANDROID_API_T__=33',
    #'-D__ANDROID_API_U__=34',
  ],
  dependencies: [
    droidlet_host_hwui_stubs_dep,
    droidlet_host_gralloc_dep,
    libbase_dep,
    libutils_dep,
    libcutils_dep,
    liblog_dep,
    libskia_dep,
    libui_dep,
    libnativehelper_dep,
    libandroidfw_dep,
    libgui_dep,
    libminikin_dep,
    libnativedisplay_dep,
    libnativewindow_dep,
    libbinder_dep,
    libbinder_ndk_dep,
    libipcrenderbuffer_dep,
    libsync_dep,
    libshaders_dep,
    libtonemap_dep,
    dependency('harfbuzz'),
    dependency('epoxy'),
    dependency('vulkan'),
    dependency('libgif'),
    dependency('wayland-client'),
    dependency('wayland-egl'),
    droidlet_wayland_dep,
  ],
  install: true,
)

libhwui_dep = declare_dependency(
  include_directories: [
    libhwui_includes,
    'apex/include',
  ],
  link_with: libhwui,
)
