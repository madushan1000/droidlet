libandroid_runtime = shared_library(
  'android_runtime',
  [
    libandroid_runtime_srcs,
    com_android_base_core_jni_flags_cpp,
  ],
  include_directories: [
    libandroid_runtime_includes,
    system_core_includes,
    #system_media_audio_includes,
    frameworks_native_includes,
    frameworks_native_libs_math_includes,
    bionic_kernel_includes,
    '../../../native/libs/arect/include',
  ],
  cpp_args: [
    '-std=c++23',
    #'--include/usr/include/epoxy/egl.h',
    '-D__INTRODUCED_IN(x)=',
    '-DPROPERTY_KEY_MAX=32',
    '-DPROP_NAME_MAX=32',
    '-D__CPU_BITTYPE=unsigned long int',
    '-DGL_GLEXT_PROTOTYPES',
    #'-D__ANDROID__'
  ],
  dependencies: [
    droidlet_host_egl_dep,
    droidlet_host_vulkan_dep,
    droidlet_host_gl_oes_dep,
    droidlet_host_perfetto_dep,
