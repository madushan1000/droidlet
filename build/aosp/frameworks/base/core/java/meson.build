framework_core_aidl = []

foreach aidl_file: framework_core_aidl_srcs
  framework_core_aidl += custom_target(
    build_by_default: true,
    input: aidl_file,
    output: '@BASENAME@.java',
    build_subdir: 'aidl'/ fs.relative_to(fs.parent(aidl_file), meson.current_source_dir()),
    command: [
      aidl,
      '--lang=java',
      '-I', fs.relative_to(meson.current_source_dir(), meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/base/graphics/java' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/native/aidl/binder' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/base/media/java' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/native/aidl/gui' , meson.project_build_root()),
      #'-I', fs.relative_to(meson.project_source_root() / 'hardware/interfaces/camera/common/aidl' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/av/camera/aidl' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/base/cmds/idmap2/idmap2d/aidl/core' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'hardware/interfaces/contexthub/aidl' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'hardware/interfaces/graphics/common/aidl' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'hardware/interfaces/biometrics/fingerprint/aidl' , meson.project_build_root()),
      '-I', fs.relative_to(meson.project_source_root() / 'frameworks/native/libs/input' , meson.project_build_root()),
      '--out=.',
      '@INPUT@'
    ],
  )
endforeach


