libandroid_includes = include_directories('include')

libandroid = shared_library(
  'android',
  [
    #'activity_manager.cpp',
    'asset_manager.cpp',
    'surface_control_input_receiver.cpp',
    'choreographer.cpp',
    'configuration.cpp',
    'display_luts.cpp',
    #'dynamic_instrumentation_manager.cpp',
    'hardware_buffer_jni.cpp',
    'input.cpp',
    'input_transfer_token.cpp',
    'looper.cpp',
    'native_activity.cpp',
    'native_service.cpp',
    'native_window_jni.cpp',
    'obb.cpp',
    #'permission_manager.cpp',
    #'performance_hint.cpp',
    #'sensor.cpp',
    'sharedmem.cpp',
    #'storage_manager.cpp',
    'surface_control.cpp',
    'surface_texture.cpp',
    'system_fonts.cpp',
    #'system_health.cpp',
    'trace.cpp',
    #'thermal.cpp',
  ],
  include_directories: [
    libandroid_includes,
    frameworks_native_includes,
    frameworks_native_libs_math_includes,
    frameworks_native_private_includes,
    frameworks_base_core_jni,
    system_core_includes,
  ],
  cpp_args: [
    '-std=c++20',
    '-D__INTRODUCED_IN(x)=',
  ],
  dependencies: [
    droidlet_host_sensors_dep,
    libbase_dep,
    liblog_dep,
    libutils_dep,
    libcutils_dep,
    libandroidfw_dep,
    libinput_dep,
