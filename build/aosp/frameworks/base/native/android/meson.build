    libminikin_dep,
    libhwui_dep,
    libnativewindow_dep,
    libnativehelper_dep,
    libnativedisplay_dep,
    libskia_dep,
    dependency('libxml-2.0'),
    dependency('harfbuzz'),
  ],
  install: true,
)

libandroid_dep = declare_dependency(
  include_directories: libandroid_includes,
  link_with: libandroid,
)
