com_android_graphics_libgui_flags_cpp = custom_target(
  input: 'libgui_flags.aconfig',
  command: [
    gen_aconfig_cpp_stubs,
    '@INPUT@',
    'com.android.graphics.libgui.flags',
  ],
  capture: true,
  output: 'com_android_graphics_libgui_flags.h',
)
com_android_graphics_libgui_flags_cpp_dep = declare_dependency(
  sources: [com_android_graphics_libgui_flags_cpp],
  include_directories: include_directories('.'),
)

