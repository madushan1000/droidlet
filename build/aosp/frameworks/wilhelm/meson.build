# Host build of the OpenSL ES implementation.
#
# The Android build uses the AudioFlinger/AudioTrack backend.  On the host we
# use Wilhelm's desktop SDL + libsndfile backend, which provides real audio
# output and the buffer-queue/player API used by NDK apps.

wilhelm_src = files(
  'src/OpenSLES_IID.cpp',
  'src/classes.cpp',
  'src/data.cpp',
  'src/devices.cpp',
  'src/entry.cpp',
  'src/handler_bodies.cpp',
  'src/trace.cpp',
  'src/locks.cpp',
  'src/sles.cpp',
  'src/sl_iid.cpp',
  'src/sllog.cpp',
  'src/ThreadPool.cpp',
  'src/autogen/IID_to_MPH.cpp',
  'src/objects/C3DGroup.cpp',
  'src/objects/CAudioPlayer.cpp',
  'src/objects/CAudioRecorder.cpp',
  'src/objects/CEngine.cpp',
  'src/objects/COutputMix.cpp',
  'src/objects/CMediaPlayer.cpp',
  'src/itf/IBassBoost.cpp',
  'src/itf/IBufferQueue.cpp',
  'src/itf/IDynamicInterfaceManagement.cpp',
  'src/itf/IEffectSend.cpp',
  'src/itf/IEngine.cpp',
  'src/itf/IEngineCapabilities.cpp',
  'src/itf/IEnvironmentalReverb.cpp',
  'src/itf/IEqualizer.cpp',
  'src/itf/IMetadataExtraction.cpp',
  'src/itf/IMuteSolo.cpp',
  'src/itf/IObject.cpp',
  'src/itf/IOutputMix.cpp',
  'src/itf/IOutputMixExt.cpp',
  'src/itf/IPlay.cpp',
  'src/itf/IPlaybackRate.cpp',
  'src/itf/IPrefetchStatus.cpp',
  'src/itf/IPresetReverb.cpp',
  'src/itf/IRecord.cpp',
  'src/itf/ISeek.cpp',
  'src/itf/IStreamInformation.cpp',
  'src/itf/IVirtualizer.cpp',
  'src/itf/IVolume.cpp',
  'src/MPH_to.c',
  'src/handlers.c',
  'src/sync.cpp',
  'src/xa_iid.cpp',
  'src/itf/I3DCommit.cpp',
  'src/itf/I3DDoppler.cpp',
  'src/itf/I3DGrouping.cpp',
  'src/itf/I3DLocation.cpp',
  'src/itf/I3DMacroscopic.cpp',
  'src/itf/I3DSource.cpp',
  'src/itf/IAudioDecoderCapabilities.cpp',
  'src/itf/IAudioEncoder.cpp',
  'src/itf/IAudioEncoderCapabilities.cpp',
  'src/itf/IAudioIODeviceCapabilities.cpp',
  'src/itf/IDeviceVolume.cpp',
  'src/itf/IDynamicSource.cpp',
  'src/itf/ILEDArray.cpp',
  'src/itf/IMetadataTraversal.cpp',
  'src/itf/IMIDIMessage.cpp',
  'src/itf/IMIDIMuteSolo.cpp',
  'src/itf/IMIDITempo.cpp',
  'src/itf/IMIDITime.cpp',
  'src/itf/IPitch.cpp',
  'src/itf/IRatePitch.cpp',
  'src/itf/IThreadSync.cpp',
  'src/itf/IVibra.cpp',
  'src/itf/IVisualization.cpp',
  'src/desktop/SDL.cpp',
  'src/desktop/SndFile.cpp',
  'src/ut/OpenSLESUT.c',
  'src/ut/slesutResult.c',
)

wilhelm_includes = include_directories(
  'include',
  'src',
  'src/autogen',
  'src/desktop',
  'src/ut',
  '../../libnativehelper/include_jni',
  '../../system/logging/liblog/include',
  '../../frameworks/av/include',
)
wilhelm_cflags = [
  '-DUSE_SDL',
  '-DUSE_SNDFILE',
  '-DUSE_OUTPUTMIXEXT',
  '-DUSE_PROFILES=(USE_PROFILES_GAME|USE_PROFILES_MUSIC|USE_PROFILES_PHONE|USE_PROFILES_OPTIONAL|USE_PROFILES_BASE)',
  '-DUSE_ANDROID_COMPAT',
  '-DUSE_DESIGNATED_INITIALIZERS',
  '-Wno-narrowing',
  '-fpermissive',
  '-include', droidlet_host_opensles_compat_header,
  '-DUSE_LOG=SLAndroidLogLevel_Info',
  '-fvisibility=hidden',
  '-DLI_API=__attribute__((visibility("default")))',
  '-DSL_API=__attribute__((visibility("default")))',
  '-Wno-unused-parameter',
  '-Wno-cast-function-type-mismatch',
  '-Wno-multichar',
  '-Wno-invalid-offsetof',
]

# Build-time dependencies: SDL 1.2 (`libsdl1.2-dev`, pkg-config `sdl`) and
# libsndfile (`libsndfile1-dev`, pkg-config `sndfile`).

libwilhelm = shared_library(
  'wilhelm',
  wilhelm_src,
  include_directories: wilhelm_includes,
  c_args: wilhelm_cflags,
  cpp_args: wilhelm_cflags + ['-std=c++20'],
  dependencies: [
    droidlet_host_opensles_dep,
    dependency('sdl'),
    dependency('sndfile'),
    dependency('threads'),
  ],
  install: true,
)

libopensles = shared_library(
  'OpenSLES',
  ['src/sl_entry.cpp', 'src/sl_iid.cpp'],
  version: '1.0.1',
  soversion: '1',
  include_directories: wilhelm_includes,
  c_args: ['-DLI_API=', '-DSL_API=__attribute__((visibility("default")))',
           '-include', droidlet_host_opensles_compat_header],
  cpp_args: ['-std=c++20', '-DLI_API=', '-DSL_API=__attribute__((visibility("default")))',
             '-include', droidlet_host_opensles_compat_header],
  link_with: libwilhelm,
  dependencies: [dependency('threads')],
  link_args: ['-Wl,--version-script=' + meson.current_source_dir() / 'src/libOpenSLES.map.txt'],
  install: true,
)
