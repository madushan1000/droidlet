libaidl_android_hardware_graphics_composer = static_library(
  'aidl_android_hardware_graphics_composer',
  aidl_android_hardware_graphics_composer,
  cpp_args: ['-std=c++20'],
  dependencies: [
    libaidl_android_hardware_common_dep,
    libaidl_android_hardware_graphics_common_dep,
    libbinder_dep,
    libbase_dep,
    libutils_dep,
    liblog_dep,
  ],
)

libaidl_android_hardware_graphics_composer_dep = declare_dependency(
  include_directories: ['.', '..'],
  link_with: libaidl_android_hardware_graphics_composer,
)
