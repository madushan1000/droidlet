aidl_android_hardware_graphics_common_path = meson.current_source_dir()
aidl_android_hardware_graphics_common = custom_target(
  'aidl_android_hardware_graphics_common',
  input: [
    'android/hardware/graphics/common/AlphaInterpretation.aidl',
    'android/hardware/graphics/common/BlendMode.aidl',
    'android/hardware/graphics/common/BufferUsage.aidl',
    'android/hardware/graphics/common/ChromaSiting.aidl',
    'android/hardware/graphics/common/ColorTransform.aidl',
    'android/hardware/graphics/common/Compression.aidl',
    'android/hardware/graphics/common/Cta861_3.aidl',
    'android/hardware/graphics/common/Dataspace.aidl',
    'android/hardware/graphics/common/DisplayDecorationSupport.aidl',
    'android/hardware/graphics/common/DisplayHotplugEvent.aidl',
    'android/hardware/graphics/common/ExtendableType.aidl',
    'android/hardware/graphics/common/FRect.aidl',
    'android/hardware/graphics/common/HardwareBuffer.aidl',
    'android/hardware/graphics/common/HardwareBufferDescription.aidl',
    'android/hardware/graphics/common/Hdr.aidl',
    'android/hardware/graphics/common/HdrConversionCapability.aidl',
    'android/hardware/graphics/common/HdrConversionStrategy.aidl',
    'android/hardware/graphics/common/Interlaced.aidl',
    'android/hardware/graphics/common/PixelFormat.aidl',
    'android/hardware/graphics/common/PlaneLayout.aidl',
    'android/hardware/graphics/common/PlaneLayoutComponent.aidl',
    'android/hardware/graphics/common/PlaneLayoutComponentType.aidl',
    'android/hardware/graphics/common/Point.aidl',
    'android/hardware/graphics/common/Rect.aidl',
    'android/hardware/graphics/common/Smpte2086.aidl',
    'android/hardware/graphics/common/StandardMetadataType.aidl',
    'android/hardware/graphics/common/Transform.aidl',
    'android/hardware/graphics/common/XyColor.aidl',
  ],
  output: [

    'android/hardware/graphics/common/AlphaInterpretation.cpp',
    'android/hardware/graphics/common/BlendMode.cpp',
    'android/hardware/graphics/common/BufferUsage.cpp',
    'android/hardware/graphics/common/ChromaSiting.cpp',
    'android/hardware/graphics/common/ColorTransform.cpp',
    'android/hardware/graphics/common/Compression.cpp',
    'android/hardware/graphics/common/Cta861_3.cpp',
    'android/hardware/graphics/common/Dataspace.cpp',
    'android/hardware/graphics/common/DisplayDecorationSupport.cpp',
    'android/hardware/graphics/common/DisplayHotplugEvent.cpp',
    'android/hardware/graphics/common/ExtendableType.cpp',
    'android/hardware/graphics/common/FRect.cpp',
    'android/hardware/graphics/common/HardwareBuffer.cpp',
    'android/hardware/graphics/common/HardwareBufferDescription.cpp',
    'android/hardware/graphics/common/HdrConversionCapability.cpp',
    'android/hardware/graphics/common/HdrConversionStrategy.cpp',
    'android/hardware/graphics/common/Hdr.cpp',
    'android/hardware/graphics/common/Interlaced.cpp',
    'android/hardware/graphics/common/PixelFormat.cpp',
    'android/hardware/graphics/common/PlaneLayoutComponent.cpp',
    'android/hardware/graphics/common/PlaneLayoutComponentType.cpp',
    'android/hardware/graphics/common/PlaneLayout.cpp',
    'android/hardware/graphics/common/Point.cpp',
    'android/hardware/graphics/common/Rect.cpp',
    'android/hardware/graphics/common/Smpte2086.cpp',
    'android/hardware/graphics/common/StandardMetadataType.cpp',
    'android/hardware/graphics/common/Transform.cpp',
    'android/hardware/graphics/common/XyColor.cpp',
    'aidl/android/hardware/graphics/common/AlphaInterpretation.h',
    'aidl/android/hardware/graphics/common/BlendMode.h',
    'aidl/android/hardware/graphics/common/BufferUsage.h',
    'aidl/android/hardware/graphics/common/ChromaSiting.h',
    'aidl/android/hardware/graphics/common/ColorTransform.h',
    'aidl/android/hardware/graphics/common/Compression.h',
    'aidl/android/hardware/graphics/common/Cta861_3.h',
    'aidl/android/hardware/graphics/common/Dataspace.h',
    'aidl/android/hardware/graphics/common/DisplayDecorationSupport.h',
    'aidl/android/hardware/graphics/common/DisplayHotplugEvent.h',
    'aidl/android/hardware/graphics/common/ExtendableType.h',
    'aidl/android/hardware/graphics/common/FRect.h',
    'aidl/android/hardware/graphics/common/HardwareBufferDescription.h',
    'aidl/android/hardware/graphics/common/HardwareBuffer.h',
    'aidl/android/hardware/graphics/common/HdrConversionCapability.h',
    'aidl/android/hardware/graphics/common/HdrConversionStrategy.h',
    'aidl/android/hardware/graphics/common/Hdr.h',
    'aidl/android/hardware/graphics/common/Interlaced.h',
    'aidl/android/hardware/graphics/common/PixelFormat.h',
    'aidl/android/hardware/graphics/common/PlaneLayoutComponent.h',
    'aidl/android/hardware/graphics/common/PlaneLayoutComponentType.h',
    'aidl/android/hardware/graphics/common/PlaneLayout.h',
    'aidl/android/hardware/graphics/common/Point.h',
    'aidl/android/hardware/graphics/common/Rect.h',
    'aidl/android/hardware/graphics/common/Smpte2086.h',
    'aidl/android/hardware/graphics/common/StandardMetadataType.h',
    'aidl/android/hardware/graphics/common/Transform.h',
    'aidl/android/hardware/graphics/common/XyColor.h',
  ],
  build_by_default: true,
  command: [
    aidl,
    '--lang=ndk',
    '-I', fs.relative_to(meson.current_source_dir(), meson.project_build_root()),
    '-I', aidl_android_hardware_common_path,
    '--stability=vintf',
    '--structured',
    '-o', meson.current_build_dir(),
    '-h', meson.current_build_dir(),
    '@INPUT@',
  ],
)

libaidl_android_hardware_graphics_common = static_library(
  'aidl_android_hardware_graphics_common',
  aidl_android_hardware_graphics_common,
  cpp_args: ['-std=c++20'],
  dependencies: [
    libaidl_android_hardware_common_dep,
    libbinder_dep,
    libbase_dep,
    libutils_dep,
    liblog_dep,
  ],
)

libaidl_android_hardware_graphics_common_dep = declare_dependency(
  include_directories: ['.', '..'],
  link_with: libaidl_android_hardware_graphics_common,
)
