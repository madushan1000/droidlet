  'monitor_linux.cc',
  'runtime_linux.cc',
  'thread_linux.cc',
]

art_operator_gen_srcs = [
  'base/callee_save_type.h',
  'base/locks.h',
  'class_status.h',
  'compilation_kind.h',
  'gc/allocator/rosalloc.h',
