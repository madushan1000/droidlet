  'trace_profile.h',
  'verifier/verifier_enums.h',
]

art_operator_gen_outs = []

foreach name : art_operator_gen_srcs
  art_operator_gen_outs += operator_srcs_gen.process(
    name,
    extra_args: 'art/runtime',
  )
endforeach

libart_runtime_src += art_operator_gen_outs

if target_machine.cpu() == 'x86_64'
  libart_runtime_src += custom_target(
    'libart_mterp.x86_64ng',
    input: [
      'interpreter/mterp/x86_64ng/arithmetic.S',
      'interpreter/mterp/x86_64ng/array.S',
      'interpreter/mterp/x86_64ng/control_flow.S',
      'interpreter/mterp/x86_64ng/floating_point.S',
      'interpreter/mterp/x86_64ng/invoke.S',
      'interpreter/mterp/x86_64ng/main.S',
      'interpreter/mterp/x86_64ng/object.S',
      'interpreter/mterp/x86_64ng/other.S',
    ],
    command: [
      python,
      '@CURRENT_SOURCE_DIR@/interpreter/mterp/gen_mterp.py',
      '@OUTPUT@',
      '@INPUT@',
    ],
    output: 'mterp_x86_64ng.S',
  )
  libart_runtime_src += [
    'interpreter/mterp/nterp.cc',
    'arch/x86_64/memcmp16_x86_64.S',
    'arch/x86_64/native_entrypoints_x86_64.S',
    'arch/x86_64/thread_x86_64.cc',
    'monitor_pool.cc',
    'arch/x86/fault_handler_x86.cc',
  ]
endif

libart_runtime_flags = [
  '-DBUILDING_LIBART',
  '-DMTERP_USE_AVX',
  '-fsanitize-address-use-after-return=never',
  '-fno-delete-null-pointer-checks',
  '-Wno-unused-command-line-argument',
  '-Wl,--keep-unique,__jit_debug_register_code',
  '-Wl,--keep-unique,__dex_debug_register_code',
]

libart_runtime_includes = include_directories(
  [
    '.',
    'gc',
  ],
)

libart = shared_library(
  'art',
  libart_runtime_src,
  include_directories: [libart_runtime_includes],
  cpp_args: art_default_cflags + libart_runtime_flags + ['-std=c++20'],
  dependencies: [
    libartbase_dep,
    libbase_dep,
    libnativehelper_dep,
    libdexfile_dep,
    asm_defines_dep,
    libartpalette_dep,
    libdlmalloc_dep,
    libunwindstack_dep,
    libsigchain_dep,
    libprofile_dep,
    libutils_dep,
    liblog_dep,
    libart_cmdlineparser_dep,
    libelffile_dep,
    libnativebridge_dep,
    libnativeloader_dep,
    libart_compiler_dep,
    libcpu_features_dep,
    libfmt_dep,
    libz_dep,
    tinyxml2_dep,
    lz4_dep,
    com_android_art_flags_cpp_dep,
  ],
  install: true,
)

libart_dep = declare_dependency(include_directories: libart_runtime_includes, link_with: libart)
