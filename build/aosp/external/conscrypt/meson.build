com_android_org_conscrypt_flags = custom_target(
  capture: true,
  input: ['conscrypt.aconfig'],
  output: ['com/android/org/conscrypt/flags/Flags.java'],
  command: [
    gen_aconfig_java_stubs,
    '@INPUT@',
  ],
)

com_android_org_conscrypt_net_flags = custom_target(
  capture: true,
  input: ['networksecurity.aconfig'],
  output: ['com/android/org/conscrypt/net/flags/Flags.java'],
  command: [
    gen_aconfig_java_stubs,
    '@INPUT@',
  ],
)
conscrypt_generate_constants_exe = executable(
  'conscrypt_generate_constants',
  'constants/src/gen/cpp/generate_constants.cc',
  dependencies: [libcrypto_dep, libssl_dep],
)

conscrypt_unbundled_generated_constants = custom_target(
  'conscrypt_unbundled_generated_constants',
  output: 'unbundled_NativeConstants.java',
  command: [conscrypt_generate_constants_exe],
  capture: true,
)

conscrypt_generated_constants = custom_target(
  'conscrypt_generated_constants',
  build_by_default: true,
  output: 'NativeConstants.java',
  command: [
    conscrypt_generate_constants_exe,
    'com.android.org.conscrypt',
  ],
  capture: true,
)

conscrypt_generated_blocklist = custom_target(
  'conscrypt_generated_blocklist',
  input: ['constants/src/gen/java/generate_blocklist.awk'],
  output: 'StaticBlocklist.java',
  command: [
    'awk',
    '-v', 'package=com.android.org.conscrypt',
    '-f', '@INPUT@',
  ],
  capture: true,
)

conscrypt_generated_flatbuffers = custom_target(
  'conscrypt_generated_flatbuffers',
  build_by_default: true,
  input: 'platform/src/main/ct_log_store.fbs',
  output: [
    'com/android/org/conscrypt/ct/fbs/Log.java',
    'com/android/org/conscrypt/ct/fbs/LogList.java',
    'com/android/org/conscrypt/ct/fbs/LogState.java',
    'com/android/org/conscrypt/ct/fbs/LogType.java',
  ],
  command: [
    flatc,
    '-o', meson.current_build_dir(),
    '--java', '@INPUT@',
  ],
)

