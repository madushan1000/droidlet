conscrypt_public_api_files = [
  'publicapi/src/main/java/android/net/ssl/EchConfigList.java',
  'publicapi/src/main/java/android/net/ssl/EchConfigMismatchException.java',
  'publicapi/src/main/java/android/net/ssl/InvalidEchDataException.java',
  'publicapi/src/main/java/android/net/ssl/PakeClientKeyManagerParameters.java',
  'publicapi/src/main/java/android/net/ssl/PakeOption.java',
  'publicapi/src/main/java/android/net/ssl/PakeServerKeyManagerParameters.java',
  'publicapi/src/main/java/android/net/ssl/SSLEngines.java',
  'publicapi/src/main/java/android/net/ssl/SSLSockets.java',
]
conscrypt = jar(
  'conscrypt',
  [
    conscrypt_java_files,
    conscrypt_public_api_files,
    conscrypt_generated_constants,
    conscrypt_generated_blocklist,
    conscrypt_generated_flatbuffers,
    flatbuffers_srcs,
    com_android_org_conscrypt_flags,
    com_android_org_conscrypt_net_flags,
    'repackaged/common/src/main/java/com/android/org/conscrypt/metrics/ConscryptStatsLog.java',
  ],
  java_args: [
    '-source', '21',
    '-target', '21',
    '-encoding', 'UTF-8',
    '-proc:none',
    '-nowarn',
    '-Xlint:-unchecked',
    '-Xlint:-deprecation',
    '-Xlint:-removal',
    '-XDskipDuplicateBridges=true',
    '-XDstringConcat=inline',
    '--system', 'none',
    '--module-path', core_all.full_path(),
    '--add-exports=java.base/android.compat.annotation=ALL-UNNAMED',
    '--add-exports=java.base/libcore.api=ALL-UNNAMED',
    '--add-exports=java.base/android.annotation=ALL-UNNAMED',
    '--add-exports=java.base/android.crypto.hpke=ALL-UNNAMED',
    '--add-exports=java.base/dalvik.annotation.compat=ALL-UNNAMED',
    '--add-exports=java.base/com.android.libcore=ALL-UNNAMED',
  ],
  link_with: [core_all],
  build_subdir: 'conscrypt',
)

conscrypt_hostdex = custom_target(
  'conscrypt-hostdex.jar',
  build_by_default: true,
  input: [conscrypt],
  output: 'conscrypt-hostdex.jar',
  command: [
    d8,
    #'--android-platform-build',
    #'--no-desugaring',
    '--min-api', '35',
    '--output', '@OUTPUT@',
    '@INPUT@',
  ],
  install: true,
  install_dir: 'framework'
)

# System CA store used by Conscrypt/TrustedCertificateStore.  The host has no
# /apex/com.android.conscrypt mount, so TrustedCertificateStore falls back to
# $ANDROID_ROOT/etc/security/cacerts.
install_subdir(
  'apex/ca-certificates/files',
  install_dir: 'etc/security/cacerts',
  strip_directory: true,
)
