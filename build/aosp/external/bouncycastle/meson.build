  'repackaged/bcprov/src/main/java/com/android/org/bouncycastle/x509/X509V3CertificateGenerator.java',
]
bouncycastle = jar(
  'bouncycastle',
  bouncycastle_java_files,
  java_args: [
    '-source', '21',
    '-target', '21',
    '-encoding', 'UTF-8',
    '-proc:none',
    '-nowarn',
    '-Xlint:-unchecked',
    '-Xlint:-deprecation',
    '-Xlint:-removal',
    '-XDskipDuplicateBridges=true',
    '-XDstringConcat=inline',
    '--system', 'none',
    '--module-path', core_all.full_path(),
    '--add-exports=java.base/android.compat.annotation=ALL-UNNAMED',
    #'--patch-module', 'java.base=' + okhttp_impl_module_path,
  ],
  link_with: [core_all],
)


bouncycastle_hosdex = custom_target(
  'bouncycastle-hostdex.jar',
  build_by_default: true,
  input: [bouncycastle],
  output: 'bouncycastle-hostdex.jar',
  command: [
    d8,
    #'-Dcom.android.tools.r8.emitRecordAnnotationsInDex',
    #'-Dcom.android.tools.r8.emitPermittedSubclassesAnnotationsInDex',
    #'--android-platform-build',
    #'--no-desugaring',
    '--min-api', '35',
    '--output', '@OUTPUT@',
    '@INPUT@',
  ],
  install: true,
  install_dir: 'framework'
)
